{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": ["core:default", "core:path:default", "dialog:allow-ask", "dialog:allow-confirm", "dialog:allow-message", "dialog:allow-open", "dialog:allow-save", {
    "identifier": "shell:allow-open",
    "allow": [
      { "url": "https://*" },
      { "url": "http://*" }
    ]
  }]
}
